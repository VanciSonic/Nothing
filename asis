    local function CreateBubble(text, isUser)

        local Alignment = Instance.new("Frame")
        Alignment.BackgroundTransparency = 1
        Alignment.Size = UDim2.new(1, 0, 0, 0)
        Alignment.AutomaticSize = Enum.AutomaticSize.Y
        Alignment.Parent = ChatScroll

        local AlignLayout = Instance.new("UIListLayout")
        AlignLayout.FillDirection = Enum.FillDirection.Horizontal
        AlignLayout.HorizontalAlignment =
            isUser
            and Enum.HorizontalAlignment.Right
            or Enum.HorizontalAlignment.Left
        AlignLayout.Parent = Alignment

        local BubbleFrame = Instance.new("Frame")
        BubbleFrame.BackgroundColor3 =
            isUser
            and Color3.fromRGB(152, 255, 152)
            or Color3.fromRGB(255, 255, 255)

        BubbleFrame.AutomaticSize = Enum.AutomaticSize.XY
        BubbleFrame.Size = UDim2.new(0, 0, 0, 0)
        BubbleFrame.Parent = Alignment

        local BubbleCorner = Instance.new("UICorner")
        BubbleCorner.CornerRadius = UDim.new(0, 20)
        BubbleCorner.Parent = BubbleFrame

        local BubblePad = Instance.new("UIPadding")
        BubblePad.PaddingTop = UDim.new(0, 8)
        BubblePad.PaddingBottom = UDim.new(0, 8)
        BubblePad.PaddingLeft = UDim.new(0, 12)
        BubblePad.PaddingRight = UDim.new(0, 12)
        BubblePad.Parent = BubbleFrame

        local BubbleText = Instance.new("TextLabel")
        BubbleText.BackgroundTransparency = 1
        BubbleText.Size = UDim2.new(0, 0, 0, 0)
        BubbleText.AutomaticSize = Enum.AutomaticSize.XY
        BubbleText.Text = text
        BubbleText.Font = Enum.Font.GothamMedium
        BubbleText.TextSize = 12
        BubbleText.TextColor3 = Color3.fromRGB(0, 0, 0)
        BubbleText.TextWrapped = true
        BubbleText.Parent = BubbleFrame

        local MaxWidth = Instance.new("UISizeConstraint")
        MaxWidth.MaxSize = Vector2.new(200, 9999)
        MaxWidth.Parent = BubbleFrame

        local BubbleScale = Instance.new("UIScale")
        BubbleScale.Scale = 0
        BubbleScale.Parent = BubbleFrame

        TweenService:Create(
            BubbleScale,
            TweenInfo.new(
                0.4,
                Enum.EasingStyle.Exponential,
                Enum.EasingDirection.Out
            ),
            {
                Scale = 1
            }
        ):Play()

        task.defer(function()
            task.wait()
            ChatScroll.CanvasPosition =
                Vector2.new(
                    0,
                    math.max(
                        0,
                        ChatScroll.AbsoluteCanvasSize.Y
                    )
                )
        end)

    end

