    local function AddHistory(role, content)
        ChatHistory[#ChatHistory + 1] = {
            role = role,
            content = tostring(content or "")
        }

        while #ChatHistory > 12 do
            table.remove(ChatHistory, 1)
        end
    end

    local function AskAI(question)
        if not req then
            CreateBubble("❌ Executor tidak mendukung HTTP Request.", false)
            isProcessing = false
            return
        end

        local messages = {
            {
                role = "system",
                content = SYSTEM_PROMPT .. FEATURE_CATALOG
            }
        }

        for _, message in ipairs(ChatHistory) do
            messages[#messages + 1] = message
        end

        messages[#messages + 1] = {
            role = "user",
            content = question
        }

        local payload = {
            model = "openai/gpt-oss-120b",
            messages = messages,
            temperature = 0.2,
            max_tokens = 1200
        }

        local body = HttpService:JSONEncode(payload)

        local success, result = pcall(function()
            return req({
                Url = "https://api.groq.com/openai/v1/chat/completions",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. API_KEY,
                    ["User-Agent"] = "Roblox/GantengAsisten"
                },
                Body = body
            })
        end)

        if not success then
            CreateBubble("❌ Request error:\n" .. tostring(result), false)
            isProcessing = false
            return
        end

        if not result then
            CreateBubble("❌ Tidak ada response dari Ganteng Asisten.", false)
            isProcessing = false
            return
        end

        if tonumber(result.StatusCode) ~= 200 then
            local errorBody = tostring(result.Body or ""):sub(1, 2500)
            CreateBubble(
                "❌ AI HTTP Error: " .. tostring(result.StatusCode) ..
                "\n\n" .. errorBody,
                false
            )
            isProcessing = false
            return
        end

        local decodeSuccess, data = pcall(function()
            return HttpService:JSONDecode(result.Body)
        end)

        if not decodeSuccess
            or not data
            or not data.choices
            or not data.choices[1]
            or not data.choices[1].message then
            CreateBubble("❌ Gagal membaca response Ganteng Asisten.", false)
            isProcessing = false
            return
        end

        local response = tostring(data.choices[1].message.content or "")

        AddHistory("user", question)
        AddHistory("assistant", response)

        if response ~= "" then
            CreateBubble(response, false)
        else
            CreateBubble("❌ Response kosong.", false)
        end

        isProcessing = false
    end

    -- ============================================================
    -- SEND MESSAGE + 6s COOLDOWN
    -- ============================================================

    local function SendMessage()
        local text = ChatInput.Text

        if text == ""
            or string.match(text, "^%s*$")
            or isProcessing then
            return
        end

        local now = os.clock()
        local remaining = COOLDOWN - (now - LastAskAt)

        if remaining > 0 then
            CreateBubble(
                "⏳ Tunggu " .. string.format("%.1f", remaining) .. " detik sebelum bertanya lagi.",
                false
            )
            return
        end

        LastAskAt = now

        TweenService:Create(
            SendScale,
            TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Scale = 0.8}
        ):Play()

        task.wait(0.1)

        TweenService:Create(
            SendScale,
            TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
            {Scale = 1}
        ):Play()

        isProcessing = true

        CreateBubble(text, true)
        ChatInput.Text = ""

        task.spawn(function()
            AskAI(text)
        end)
    end

